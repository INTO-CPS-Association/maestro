              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK"
          }
        }
      }
    },
    "/version" : {
      "get" : {
        "tags" : [ "Simulation" ],
        "summary" : "Get Maestro version",
        "description" : "Returns the version of the running Maestro build.",
        "operationId" : "version",
        "responses" : {
          "200" : {
            "description" : "OK",
