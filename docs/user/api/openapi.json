    "/executeAlgorithm" : {
      "post" : {
        "tags" : [ "Scenario" ],
        "summary" : "Execute an algorithm and download results",
        "description" : "Runs an extended multi-model with the supplied master model and times. An empty masterModel requests algorithm generation. If sigver.verification is true, verifies before execution. Returns a ZIP archive of the working directory as application/octet-stream.",
