          }
        }
      }
    },
    "/executeViaCLI/{sessionId}" : {
      "post" : {
        "tags" : [ "Simulation" ],
        "summary" : "Select CLI execution mode",
        "description" : "Controls whether subsequent /simulate requests run via a child Java process instead of the in-process broker. Does not itself start a simulation.",
        "operationId" : "executeViaCLI",
        "parameters" : [ {
          "name" : "sessionId",
          "in" : "path",
          "required" : true,
