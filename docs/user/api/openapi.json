  "components" : {
    "schemas" : {
      "VerificationResult" : {
        "type" : "object",
        "description" : "Algorithm verification outcome. Inspect correct and errorMessage even when HTTP status is 200.",
        "properties" : {
          "correct" : {
            "type" : "boolean",
            "description" : "True only when verification succeeded."
          },
          "masterModel" : {
            "type" : "string",
            "description" : "Generated UPPAAL XML encoding, or an empty string when unavailable."
          },
          "errorMessage" : {
            "type" : "string",
            "description" : "Verification failure or missing-tool message; empty on success."
          }
        }
      },
      "SimulateRequestBody" : {
        "type" : "object",
        "description" : "Times and logging settings for co-simulation of an initialized session.",
        "properties" : {
          "startTime" : {
            "type" : "number",
            "format" : "double",
            "description" : "Start time of the co-simulation in simulation time units.",
            "example" : 0
          },
          "endTime" : {
            "type" : "number",
            "format" : "double",
            "description" : "End time of the co-simulation in simulation time units.",
            "example" : 10
          },
          "logLevels" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "array",
              "items" : {
                "type" : "string"
              }
            },
            "description" : "Enabled FMI logging categories by instance, using keys such as {FMU}.instanceName."
          },
          "reportProgress" : {
            "type" : "boolean",
            "description" : "Request progress reporting during execution."
          },
          "liveLogInterval" : {
            "type" : "number",
            "format" : "double",
            "description" : "Simulation-time interval between WebSocket data updates; zero allows updates at every step.",
            "example" : 0.1
          },
          "masterModel" : {
            "type" : "string",
            "description" : "Scenario master-model configuration text, used by scenario-based simulation."
          }
        }
      },
      "StatusModel" : {
        "type" : "object",
        "description" : "Session status or operation result. Status is a message, not an HTTP status code.",
        "properties" : {
          "status" : {
            "type" : "string",
            "description" : "Current session state or operation message.",
            "example" : "Simulation completed"
          },
          "sessionId" : {
            "type" : "string",
            "description" : "Session identifier returned by createSession."
          },
          "lastExecTime" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Duration of the last execution in milliseconds."
          },
          "warnings" : {
            "type" : "array",
            "description" : "Warnings or captured process output, depending on execution mode. May be null.",
            "items" : {
              "type" : "string"
            }
          },
          "errors" : {
            "type" : "array",
            "description" : "Reported errors or captured child-process stderr. May be null; not all failure paths populate this field.",
            "items" : {
              "type" : "string"
            }
          }
        }
      },
      "SigverSimulateRequestBody" : {
        "type" : "object",
        "description" : "Execution options and an explicit scenario master model.",
        "properties" : {
          "startTime" : {
            "type" : "number",
            "format" : "double",
            "description" : "Start time of the co-simulation in simulation time units.",
            "example" : 0
          },
          "endTime" : {
            "type" : "number",
            "format" : "double",
            "description" : "End time of the co-simulation in simulation time units.",
            "example" : 10
          },
          "logLevels" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "array",
              "items" : {
                "type" : "string"
              }
            },
            "description" : "Enabled FMI logging categories by instance, using keys such as {FMU}.instanceName."
          },
          "reportProgress" : {
            "type" : "boolean",
            "description" : "Request progress reporting during execution."
          },
          "liveLogInterval" : {
            "type" : "number",
            "format" : "double",
            "description" : "Simulation-time interval between WebSocket data updates; zero allows updates at every step.",
            "example" : 0.1
          },
          "masterModel" : {
            "type" : "string",
            "description" : "Master-model configuration text containing the scenario, connections, initialization, and co-simulation steps."
          }
        }
      },
      "BoundedDifferenceConstraint" : {
        "allOf" : [ {
          "$ref" : "#/components/schemas/VarStepConstraint"
        }, {
          "type" : "object",
          "properties" : {
            "ports" : {
              "type" : "array",
              "description" : "Qualified signal names monitored by the constraint.",
              "items" : {
                "type" : "string"
              }
            },
            "reltol" : {
              "type" : "number",
              "format" : "double",
              "description" : "Relative tolerance for the bounded difference."
            },
            "abstol" : {
              "type" : "number",
              "format" : "double",
              "description" : "Absolute tolerance for the bounded difference."
            },
            "safety" : {
              "type" : "number",
              "format" : "double",
              "description" : "Safety factor used when adapting the step size."
            },
            "skipDiscrete" : {
              "type" : "boolean",
              "description" : "Whether to skip discrete signals."
            }
          }
        } ],
        "description" : "Bounded-difference constraint (type boundeddifference)."
      },
      "FixedStepAlgorithmConfig" : {
        "allOf" : [ {
          "$ref" : "#/components/schemas/IAlgorithmConfig"
        }, {
          "type" : "object",
          "properties" : {
            "size" : {
              "type" : "number",
              "format" : "double",
              "description" : "Fixed communication step size in simulation time units.",
              "example" : 0.1
            }
          }
        } ],
        "description" : "Fixed-step algorithm. Set type to fixed-step."
      },
      "FmuMaxStepSizeConstraint" : {
        "allOf" : [ {
          "$ref" : "#/components/schemas/VarStepConstraint"
        } ],
        "description" : "FMU maximum-step-size constraint (type fmumaxstepsize)."
      },
      "IAlgorithmConfig" : {
        "type" : "object",
        "description" : "Simulation step algorithm. Select fixed-step or var-step using the type property.",
        "discriminator" : {
          "propertyName" : "type"
        },
        "properties" : {
          "type" : {
            "type" : "string"
          }
        },
        "required" : [ "type" ]
      },
      "InitializationData" : {
        "type" : "object",
        "description" : "Session multi-model configuration. FMU paths and external specifications are resolved on the server. FMU, connection, parameter, and algorithm fields are inherited from MultiModel.",
        "properties" : {
          "fmus" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "string"
            },
            "description" : "Map from FMU identifiers such as {FMU} to FMU file locations on the server."
          },
          "connections" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "array",
              "items" : {
                "type" : "string"
              }
            },
            "description" : "Output-to-input connections. Keys and values use {FMU}.instanceName.signal; each output can feed multiple inputs."
          },
          "parameters" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "object"
            },
            "description" : "Parameter values keyed by {FMU}.instanceName.signal, with values matching the FMI scalar type."
          },
          "logVariables" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "array",
              "items" : {
                "type" : "string"
              }
            },
            "description" : "Signals to record, mapped from {FMU}.instanceName to signal names."
          },
          "parallelSimulation" : {
            "type" : "boolean",
            "description" : "Request parallel stepping. The web API currently rejects true."
          },
          "stabalizationEnabled" : {
            "type" : "boolean",
            "description" : "Enable stabilization during initialization. The historical JSON spelling is retained."
          },
          "global_absolute_tolerance" : {
            "type" : "number",
            "format" : "double",
            "description" : "Global absolute tolerance for initialization and simulation generation."
          },
          "global_relative_tolerance" : {
            "type" : "number",
            "format" : "double",
            "description" : "Global relative tolerance for initialization and simulation generation."
          },
          "loggingOn" : {
            "type" : "boolean",
            "description" : "Enable FMI logging."
          },
          "visible" : {
            "type" : "boolean",
            "description" : "Request visible FMU instances during instantiation."
          },
          "simulationProgramDelay" : {
            "type" : "boolean",
            "description" : "Pace simulation steps towards real-time execution."
          },
          "algorithm" : {
            "description" : "Step algorithm configuration; type selects fixed-step or var-step.",
            "oneOf" : [ {
              "$ref" : "#/components/schemas/FixedStepAlgorithmConfig"
            }, {
              "$ref" : "#/components/schemas/VariableStepAlgorithmConfig"
            } ]
