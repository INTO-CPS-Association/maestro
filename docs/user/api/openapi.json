{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Maestro Web API",
    "description" : "Session-based FMI co-simulation and scenario algorithm generation, verification, and execution."
  },
  "tags" : [ {
    "name" : "Scenario",
    "description" : "Generate, verify, visualize, and execute FMI2 scenario master models. Scenario and master-model text is in the scenario verifier's configuration format, not JSON."
  }, {
    "name" : "Simulation",
    "description" : "Create a session, initialize its multi-model, run co-simulation, and download results. Session identifiers are supplied in the URL. Simulation requests block until execution completes."
  } ],
  "paths" : {
    "/stopsimulation/{sessionId}" : {
      "get" : {
        "tags" : [ "Simulation" ],
        "summary" : "Request simulation stop",
        "description" : "Sets the session stop flag. Execution stops when the running algorithm checks it; this is not a forced process termination. Prefer POST; GET is retained for compatibility.",
        "operationId" : "stop",
        "parameters" : [ {
          "name" : "sessionId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK"
          }
        }
      },
      "post" : {
        "tags" : [ "Simulation" ],
        "summary" : "Request simulation stop",
        "description" : "Sets the session stop flag. Execution stops when the running algorithm checks it; this is not a forced process termination. Prefer POST; GET is retained for compatibility.",
        "operationId" : "stop_1",
        "parameters" : [ {
          "name" : "sessionId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK"
          }
        }
      }
    },
    "/visualizeTrace" : {
      "post" : {
        "tags" : [ "Scenario" ],
        "summary" : "Visualize a verification trace",
        "description" : "Generates an MP4 counterexample trace for a master model. Requires the scenario verifier's external verification and video tools; fails if a trace cannot be generated.",
        "operationId" : "visualizeTrace",
        "requestBody" : {
          "content" : {
            "text/plain" : {
              "schema" : {
                "type" : "string"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "video/mp4" : {
                "schema" : {
                  "type" : "string",
                  "format" : "binary"
                }
              }
            }
          }
        }
      }
    },
    "/verifyAlgorithm" : {
      "post" : {
        "tags" : [ "Scenario" ],
        "summary" : "Verify a master-model algorithm",
        "description" : "Requires UPPAAL verifyta in PATH. Returns a result object, including correct=false and an errorMessage when verification fails or UPPAAL is unavailable; HTTP 200 alone does not mean the algorithm verified.",
        "operationId" : "verifyAlgorithm",
        "requestBody" : {
          "content" : {
            "text/plain" : {
              "schema" : {
                "type" : "string"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/VerificationResult"
                }
              }
            }
          }
        }
      }
    },
    "/upload/{sessionId}" : {
      "post" : {
        "tags" : [ "Simulation" ],
        "summary" : "Upload a file to a session",
        "description" : "Stores the multipart file in the session working directory for later use.",
        "operationId" : "uploadFile",
        "parameters" : [ {
          "name" : "sessionId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "type" : "object",
                "properties" : {
                  "file" : {
                    "type" : "string",
                    "format" : "binary",
                    "description" : "File to store in the session working directory"
                  }
                },
                "required" : [ "file" ]
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "description" : "OK"
          }
        }
      }
    },
    "/simulate/{sessionId}" : {
      "post" : {
        "tags" : [ "Simulation" ],
        "summary" : "Run co-simulation",
        "description" : "Generates and executes a specification using the session configuration and requested times. The request blocks until execution completes. Thrown exceptions normally return HTTP 500, but CLI-mode failures may still return HTTP 200; inspect errors and session status as well (known issue #189).",
        "operationId" : "simulate",
        "parameters" : [ {
          "name" : "sessionId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "text/plain" : {
              "schema" : {
                "$ref" : "#/components/schemas/SimulateRequestBody"
              }
            },
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SimulateRequestBody"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/StatusModel"
                }
              }
            }
          }
        }
      }
    },
    "/sigverSimulate/{sessionId}" : {
      "post" : {
        "tags" : [ "Simulation" ],
        "summary" : "Simulate a supplied master model",
        "description" : "Executes the supplied scenario master model using the initialized session. The request blocks until execution completes; results are stored in the session directory.",
        "operationId" : "sigverSimulate",
        "parameters" : [ {
          "name" : "sessionId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SigverSimulateRequestBody"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/StatusModel"
                }
              }
            }
          }
        }
      }
    },
    "/initialize/{sessionId}" : {
      "post" : {
        "tags" : [ "Simulation" ],
        "summary" : "Initialize a session",
        "description" : "Stores the multi-model configuration and reports available FMU log categories. The specification is generated later when simulation times are supplied. Prefer application/json; text/plain JSON is accepted for legacy clients. parallelSimulation and hasExternalSignals are currently rejected.",
        "operationId" : "initializeSession",
        "parameters" : [ {
          "name" : "sessionId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
