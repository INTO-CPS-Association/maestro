              "schema" : {
                "$ref" : "#/components/schemas/InitializationData"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/InitializeStatusModel"
                }
              }
            }
          }
        }
      }
    },
